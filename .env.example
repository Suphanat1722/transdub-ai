GEMINI_API_KEY=your_api_key_here
PORT=8765
TRANSLATION_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
MAX_VIDEO_BYTES=8589934592

# --- Proxy สำหรับ YouTube (ใช้เมื่อถูกบล็อก IP เท่านั้น) ---
# สำคัญ: ถ้าใช้ Webshare ต้องซื้อแพ็กเกจ "Residential" เท่านั้น
# (ไม่ใช้ Proxy Server / Static Residential ที่ยังเป็น IP datacenter)
# ถ้าปล่อยว่าง ระบบจะต่อตรงกับ YouTube
# YOUTUBE_PROXY_WEBSHARE_USER=your_residential_username
# YOUTUBE_PROXY_WEBSHARE_PASS=your_residential_password
# หรือจะใช้ proxy URL ของผู้ให้บริการอื่นก็ได้ในช่องนี้ (ใช้แทน Webshare)
# YOUTUBE_PROXY_URL=http://user:pass@host:port
